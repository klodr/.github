{
  "name": "klodr-dot-github",
  "version": "0.1.0",
  "private": true,
  "description": "Org-level reusable workflows, composite actions and shared templates for klodr/* repos.",
  "engines": {
    "node": ">=22.22.2"
  },
  "packageManager": "npm@10.9.7",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "@vitest/coverage-v8": "^4.1.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "markdownlint-cli2": "^0.23.0",
    "prettier": "^3.3.3",
    "vitest": "^4.1.5"
  },
  "lint-staged": {
    "*.{yml,yaml}": [
      "prettier --write",
      "yamllint"
    ],
    "*.md": [
      "prettier --write",
      "markdownlint-cli2"
    ],
    "*.{json,jsonc,json5}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "fast-uri": "3.1.4",
    "js-yaml@^5.0.0": "5.2.2",
    "js-yaml@^4.0.0": "4.3.0"
  }
}
